{
  "name": "openapi-explorer",
  "displayName": "%displayName%",
  "description": "%description%",
  "l10n": "./l10n",
  "version": "1.2.0",
  "publisher": "AzuraLight",
  "author": "AzuraLight <azuralight09@gmail.com>",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzuraLight/openapi-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/AzuraLight/openapi-explorer/issues"
  },
  "homepage": "https://github.com/AzuraLight/openapi-explorer#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "swagger",
    "openapi",
    "api",
    "rest",
    "rest-client",
    "api-client",
    "try-it-out",
    "code-generation",
    "typescript",
    "axios",
    "fetch",
    "curl",
    "api-gateway",
    "cors"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swaggerViewer",
          "title": "OpenAPI",
          "icon": "media/openapi.svg"
        }
      ]
    },
    "views": {
      "swaggerViewer": [
        {
          "type": "webview",
          "id": "swaggerApiInput",
          "name": "%view.apiInput%",
          "when": "swaggerViewer.inputOpen",
          "initialSize": 1
        },
        {
          "id": "swaggerExplorer",
          "name": "%view.explorer%",
          "icon": "media/openapi.svg",
          "initialSize": 5
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "swaggerExplorer",
        "contents": "%welcome%"
      }
    ],
    "commands": [
      { "command": "swaggerViewer.addApi", "title": "%cmd.addApi%", "category": "OpenAPI", "icon": "$(add)" },
      { "command": "swaggerViewer.renameApi", "title": "%cmd.renameApi%", "category": "OpenAPI" },
      { "command": "swaggerViewer.editApiUrl", "title": "%cmd.editApiUrl%", "category": "OpenAPI" },
      { "command": "swaggerViewer.copyApiUrl", "title": "%cmd.copyApiUrl%", "category": "OpenAPI" },
      { "command": "swaggerViewer.removeApi", "title": "%cmd.removeApi%", "category": "OpenAPI" },
      { "command": "swaggerViewer.refresh", "title": "%cmd.refresh%", "category": "OpenAPI", "icon": "$(refresh)" },
      { "command": "swaggerViewer.openInBrowser", "title": "%cmd.openInBrowser%", "category": "OpenAPI", "icon": "$(globe)" },
      { "command": "swaggerViewer.setToken", "title": "%cmd.setToken%", "category": "OpenAPI", "icon": "$(key)" },
      { "command": "swaggerViewer.clearToken", "title": "%cmd.clearToken%", "category": "OpenAPI" },
      { "command": "swaggerViewer.setBasicAuth", "title": "%cmd.setBasicAuth%", "category": "OpenAPI", "icon": "$(account)" },
      { "command": "swaggerViewer.clearBasicAuth", "title": "%cmd.clearBasicAuth%", "category": "OpenAPI" },
      { "command": "swaggerViewer.openSwaggerUI", "title": "%cmd.openSwaggerUI%", "category": "OpenAPI", "icon": "$(book)" },
      { "command": "swaggerViewer.search", "title": "%cmd.search%", "category": "OpenAPI", "icon": "$(search)" },
      { "command": "swaggerViewer.openOperation", "title": "%cmd.openOperation%", "category": "OpenAPI" },
      { "command": "swaggerViewer.copyTs", "title": "%cmd.copyTs%", "category": "OpenAPI" },
      { "command": "swaggerViewer.copyFetch", "title": "%cmd.copyFetch%", "category": "OpenAPI" },
      { "command": "swaggerViewer.copyAxios", "title": "%cmd.copyAxios%", "category": "OpenAPI" },
      { "command": "swaggerViewer.copyCurl", "title": "%cmd.copyCurl%", "category": "OpenAPI" }
    ],
    "keybindings": [
      {
        "command": "swaggerViewer.search",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/"
      },
      { "command": "swaggerViewer.renameApi", "key": "f2", "when": "focusedView == swaggerExplorer && !inputFocus" },
      {
        "command": "swaggerViewer.removeApi",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == swaggerExplorer && !inputFocus"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "swaggerViewer.addApi", "when": "view == swaggerExplorer", "group": "navigation@0" },
        { "command": "swaggerViewer.search", "when": "view == swaggerExplorer", "group": "navigation@1" },
        { "command": "swaggerViewer.openSwaggerUI", "when": "view == swaggerExplorer", "group": "navigation@2" },
        { "command": "swaggerViewer.refresh", "when": "view == swaggerExplorer", "group": "navigation@3" },
        { "command": "swaggerViewer.openInBrowser", "when": "view == swaggerExplorer", "group": "1_config@3" },
        { "command": "swaggerViewer.setToken", "when": "view == swaggerExplorer", "group": "2_auth@1" },
        { "command": "swaggerViewer.clearToken", "when": "view == swaggerExplorer", "group": "2_auth@2" },
        { "command": "swaggerViewer.setBasicAuth", "when": "view == swaggerExplorer", "group": "2_auth@3" },
        { "command": "swaggerViewer.clearBasicAuth", "when": "view == swaggerExplorer", "group": "2_auth@4" }
      ],
      "view/item/context": [
        { "command": "swaggerViewer.openSwaggerUI", "when": "view == swaggerExplorer && viewItem =~ /^(spec|group)/", "group": "inline" },
        { "command": "swaggerViewer.openInBrowser", "when": "view == swaggerExplorer && viewItem =~ /^(spec|group)/", "group": "1_open@1" },
        { "command": "swaggerViewer.addApi", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "0_api@1" },
        { "command": "swaggerViewer.renameApi", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "3_manage@1" },
        { "command": "swaggerViewer.editApiUrl", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "3_manage@2" },
        { "command": "swaggerViewer.copyApiUrl", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "3_manage@3" },
        { "command": "swaggerViewer.removeApi", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "9_remove@1" },
        { "command": "swaggerViewer.setToken", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "2_auth@1" },
        { "command": "swaggerViewer.clearToken", "when": "view == swaggerExplorer && viewItem =~ /^spec.*:token/", "group": "2_auth@2" },
        { "command": "swaggerViewer.setBasicAuth", "when": "view == swaggerExplorer && viewItem =~ /^spec/", "group": "2_auth@3" },
        { "command": "swaggerViewer.clearBasicAuth", "when": "view == swaggerExplorer && viewItem =~ /^spec.*:basic/", "group": "2_auth@4" },
        { "command": "swaggerViewer.copyTs", "when": "view == swaggerExplorer && viewItem == endpoint", "group": "1_copy@1" },
        { "command": "swaggerViewer.copyFetch", "when": "view == swaggerExplorer && viewItem == endpoint", "group": "1_copy@2" },
        { "command": "swaggerViewer.copyAxios", "when": "view == swaggerExplorer && viewItem == endpoint", "group": "1_copy@3" },
        { "command": "swaggerViewer.copyCurl", "when": "view == swaggerExplorer && viewItem == endpoint", "group": "1_copy@4" },
        { "command": "swaggerViewer.copyTs", "when": "view == swaggerExplorer && viewItem == model", "group": "1_copy@1" }
      ],
      "commandPalette": [
        { "command": "swaggerViewer.openOperation", "when": "false" },
        { "command": "swaggerViewer.renameApi", "when": "false" },
        { "command": "swaggerViewer.editApiUrl", "when": "false" },
        { "command": "swaggerViewer.copyApiUrl", "when": "false" },
        { "command": "swaggerViewer.removeApi", "when": "false" },
        { "command": "swaggerViewer.copyTs", "when": "false" },
        { "command": "swaggerViewer.copyFetch", "when": "false" },
        { "command": "swaggerViewer.copyAxios", "when": "false" },
        { "command": "swaggerViewer.copyCurl", "when": "false" }
      ]
    },
    "configuration": {
      "title": "OpenAPI Explorer",
      "properties": {
        "swaggerViewer.url": {
          "type": "string",
          "default": "",
          "description": "%config.url%"
        },
        "swaggerViewer.specs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "description": "%config.specs.name%" },
              "url": { "type": "string", "description": "%config.specs.url%" }
            }
          },
          "markdownDescription": "%config.specs%"
        },
        "swaggerViewer.headers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.headers%"
        },
        "swaggerViewer.strictSSL": {
          "type": "boolean",
          "default": true,
          "description": "%config.strictSSL%"
        },
        "swaggerViewer.caCertPath": {
          "type": "string",
          "default": "",
          "description": "%config.caCertPath%"
        },
        "swaggerViewer.proxy": {
          "type": "string",
          "default": "",
          "description": "%config.proxy%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run assets && npm run build",
    "assets": "node scripts/copy-swagger-ui.mjs",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md}\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test src/*.test.ts",
    "test:integration": "NODE_PATH=test/fake-vscode node --import tsx --test test/integration/*.test.ts",
    "test:webview": "NODE_PATH=test/fake-vscode playwright test",
    "sample:gateway": "node --import tsx test/fixtures/sample-gateway.ts",
    "copy-assets": "node scripts/copy-swagger-ui.mjs",
    "prepare": "node scripts/copy-swagger-ui.mjs",
    "package": "vsce package --no-dependencies -o openapi-explorer-$npm_package_version.vsix"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "https-proxy-agent": "^7.0.5",
    "prettier": "^3.3.3",
    "swagger-ui-dist": "^5.32.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
